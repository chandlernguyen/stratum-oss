# Production Environment Variables - Frontend
# Copy this file to .env.production and fill in the values
# Date: January 2026

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Google Cloud Run URL after backend deployment
VITE_API_URL=https://YOUR_CLOUD_RUN_URL_HERE

# ============================================
# SUPABASE PRODUCTION CREDENTIALS
# ============================================
# Get from Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY_HERE

# ============================================
# RECAPTCHA
# ============================================
# Get site key from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY_HERE

# ============================================
# GOOGLE ANALYTICS
# ============================================
# Get from: https://analytics.google.com
VITE_GA_ID=YOUR_GA_MEASUREMENT_ID_HERE

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
VITE_SENTRY_DSN=YOUR_FRONTEND_SENTRY_DSN_HERE
VITE_ENVIRONMENT=production
