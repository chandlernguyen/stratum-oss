# Frontend Environment Variables Example
# Copy this file to .env and update with your values
#
# For a local development stack, everything in the "Local development" block
# below is already correct and needs no editing — copy and go. The test users
# named here are seeded by supabase/seed.sql and all share the password
# LocalDevOnly123!.

# --- Local development (correct as-is for `supabase start` + the README) ---
VITE_SUPABASE_URL=http://127.0.0.1:56321
# This is the deterministic public anon key for the local Supabase stack. It is
# not a secret; it is only valid against your own machine. The app fails to boot
# (blank page, console error "Missing Supabase environment variables") if it is
# left as a placeholder.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_API_URL=http://127.0.0.1:56300

# Primary Test User (OWNER role in the SME organization). Seeded, not a
# placeholder: test@example.com does not exist in supabase/seed.sql.
TEST_EMAIL=sme.owner@example.com
TEST_PASSWORD=LocalDevOnly123!

# Agency owner (OWNER role in the agency organization).
AGENCY_OWNER_EMAIL=agency.owner@example.com
AGENCY_OWNER_PASSWORD=LocalDevOnly123!

# SME organization members
SME_MANAGER_EMAIL=sme.manager@example.com
SME_MANAGER_PASSWORD=LocalDevOnly123!
SME_ANALYST_EMAIL=sme.analyst@example.com
SME_ANALYST_PASSWORD=LocalDevOnly123!

# Agency organization members
AGENCY_ADMIN_EMAIL=agency.admin@example.com
AGENCY_ADMIN_PASSWORD=LocalDevOnly123!

# Guest / client-contact user
GUEST_EMAIL=client.contact@example.com
GUEST_PASSWORD=LocalDevOnly123!

# Test Organizations (seed IDs; see supabase/seed.sql)
TEST_SME_ORG_NAME=Test SME Company
TEST_AGENCY_ORG_NAME=Test Agency Inc

# Brand identity, so a self-hosted deployment does not advertise the original
# author's name or domain to its own users. All have neutral defaults.
VITE_BRAND_NAME=STRATUM
VITE_BRAND_DOMAIN=example.com
VITE_CONTACT_EMAIL=support@example.com
VITE_SITE_URL=http://localhost:56310

# Optional attribution. Leave unset to omit author metadata entirely.
VITE_AUTHOR_NAME=
VITE_AUTHOR_URL=

# For production, update these:
# VITE_API_URL=https://your-api-domain.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-production-anon-key

# Google reCAPTCHA v3
# Get your site key from: https://www.google.com/recaptcha/admin
# Leave blank locally to disable the captcha on signup flows.
VITE_RECAPTCHA_SITE_KEY=

# Cloudflare Turnstile (captcha on signup)
# Get your site key from: https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank locally.
VITE_TURNSTILE_SITE_KEY=

# Google Analytics
# Get your measurement ID from: https://analytics.google.com
VITE_GA_ID=