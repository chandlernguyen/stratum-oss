# Playwright E2E test environment — loaded by apps/web/playwright.config.ts.
#
# Copy this to apps/web/.env.test (gitignored) before running the E2E layer:
#
#   cp apps/web/.env.test.example apps/web/.env.test
#
# playwright.config.ts loads it at startup and the specs read every credential
# below from process.env. All values are the deterministic local-development
# defaults: the 563xx port range from supabase/config.toml and the users seeded
# by supabase/seed.sql. Every seeded user shares the password LocalDevOnly123!.

# --- Application under test ---
VITE_APP_URL=http://127.0.0.1:56310
VITE_API_BASE_URL=http://127.0.0.1:56300

# --- Supabase (local) ---
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_URL=http://127.0.0.1:56321
# Deterministic local service_role JWT (signed with the fixed local JWT secret).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

TEST_PASSWORD=LocalDevOnly123!
TEST_NEW_USER_PASSWORD=LocalDevOnly123!

