# Production Environment Variables - Backend API
# Copy this file to .env.production and fill in the values
# Date: January 2026

# ============================================
# SUPABASE PRODUCTION CREDENTIALS
# ============================================
# Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ============================================
# INTERNAL MOBILE PUSH DISPATCH
# ============================================
PUSH_DISPATCH_SECRET=SET_A_LONG_RANDOM_SECRET
PUSH_DISPATCH_BATCH_SIZE=25
PUSH_DISPATCH_MAX_ATTEMPTS=5
PUSH_DISPATCH_PROCESSING_TIMEOUT_MINUTES=10
PUSH_DISPATCH_TIMEOUT_SECONDS=10

# ============================================
# APPLE PUSH NOTIFICATION SERVICE (APNs)
# ============================================
APNS_KEY_ID=YOUR_APPLE_KEY_ID
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_TOPIC=com.example.stratumapp
# Provide either the raw .p8 contents or a mounted file path
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=/secrets/apns/AuthKey_XXXXXXXXXX.p8

# ============================================
# GOOGLE AI CREDENTIALS
# ============================================
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
GEMINI_MODEL_DEFAULT=gemini-3.8-flash
GEMINI_ENABLE_GROUNDING=true
GEMINI_THINKING_LEVEL=medium  # low | medium | high (minimal is invalid on 3.8 Flash)

# ============================================
# EMAIL (RESEND)
# ============================================
# Get from Resend Dashboard
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE

# ============================================
# RECAPTCHA (Server-side validation)
# ============================================
# Get from: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY_HERE

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=YOUR_BACKEND_SENTRY_DSN_HERE
ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=false
ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN,https://YOUR_API_DOMAIN
CORS_ENABLED=true
