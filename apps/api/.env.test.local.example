# API settings for running the backend test suite against a LOCAL stack.
#
# Copy this to apps/api/.env.test.local (gitignored) before running the
# integration suites:
#
#   cp apps/api/.env.test.local.example apps/api/.env.test.local
#
# Start the server with it layered on top of apps/api/.env:
#
#   poetry run uvicorn apps.api.main:app --host 127.0.0.1 --port 56300 \
#     --env-file apps/api/.env --env-file apps/api/.env.test.local
#
# (uvicorn accepts repeated --env-file; later files win.)
#
# The tests talk to the running server over HTTP, so they cannot change its
# behaviour themselves. This file is how the two suites that need opposite
# configurations are kept honest.

# The integration suites issue far more than 10 AI requests per minute from a
# single seeded user. With the production default they would collect a cascade
# of 429s that look like application failures. Leave enforcement ON in
# production; turn it off only for a test server.
AI_RATE_LIMIT_ENABLED="false"

# Canned model output: no Google API key needed, no cost, no network calls.
# Tests that assert on the *content* of real model output cannot pass in this
# mode by design — see TESTING.md.
DEMO_MODE="true"

# Local Supabase (563xx range from supabase/config.toml).
SUPABASE_URL="http://127.0.0.1:56321"

# The rate-limiting suite needs the opposite setting. Run it separately against
# a server started WITHOUT AI_RATE_LIMIT_ENABLED=false, with RUN_RATE_LIMIT_TESTS=1.
