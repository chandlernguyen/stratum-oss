# =====================================================================
# DEMO_MODE — run the application with no API key and no cost.
# =====================================================================
# When true, model calls return clearly-labelled canned output instead of
# calling Gemini. Nothing is sent to Google, no key is required, and no cost is
# incurred. This is enough to click through all nine agents, the agency
# client-scoped flows and the locale switcher.
#
# Set DEMO_MODE=false and provide GOOGLE_API_KEY for real analysis.
DEMO_MODE="true"

# Supabase connection details.
# For local development, get these values from the `supabase start` command output.
# For production, get these from your Supabase project dashboard.
#
# IMPORTANT: Supabase Connection Configuration
# =====================================================================
# STRAŦUM uses Supabase Python SDK which connects via REST API (PostgREST),
# NOT direct PostgreSQL connections.
#
# Local Development: Use http://127.0.0.1:56321 (custom port to avoid conflicts)
# Production: Use https://[PROJECT-REF].supabase.co (NO port number)
#
# DO NOT use PostgreSQL connection strings like:
#   ❌ postgresql://postgres:pass@db.project.supabase.co:6543/postgres
#
# The Python SDK uses REST API endpoints:
#   ✅ http://127.0.0.1:56321 (local - custom port)
#   ✅ https://YOUR_PROJECT_REF.supabase.co (production)
#
# Connection Pooling:
# - PostgREST (Supabase's REST API) handles connection pooling automatically
# - Transaction mode pooling (port 6543) applies to Supabase's internal services
# - Singleton pattern in apps/api/utils/database.py prevents creating 40+ HTTP clients
SUPABASE_URL="http://127.0.0.1:56321"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"
# Service Role Key - for backend operations (bypasses RLS)
# IMPORTANT: Singleton pattern implemented in apps/api/utils/database.py to reuse client
#
# This is the deterministic service_role JWT for the LOCAL Supabase stack. Like
# the anon key above, it is signed with the fixed local JWT secret and is
# therefore public knowledge — it grants nothing outside your own machine. It is
# filled in rather than left as a placeholder because README step 3 copies this
# file to apps/api/.env, and a placeholder value makes the API fail at startup
# with `Expected 3 parts in JWT; got 1`. Replace it with the real service_role
# key from your Supabase project dashboard before deploying anywhere.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU"
# This is the secret used to sign JWTs in your local Supabase instance.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"
SUPABASE_DB_URL="postgresql://postgres:postgres@127.0.0.1:56322/postgres"

# Internal mobile push dispatcher
PUSH_DISPATCH_SECRET="replace-with-a-long-random-secret"
PUSH_DISPATCH_BATCH_SIZE="25"
PUSH_DISPATCH_MAX_ATTEMPTS="5"
PUSH_DISPATCH_PROCESSING_TIMEOUT_MINUTES="10"
PUSH_DISPATCH_TIMEOUT_SECONDS="10"

# Apple Push Notification service (APNs)
APNS_KEY_ID="your-apple-key-id"
APNS_TEAM_ID="your-apple-team-id"
APNS_TOPIC="com.example.stratumapp"
# Provide either APNS_PRIVATE_KEY or APNS_PRIVATE_KEY_PATH
APNS_PRIVATE_KEY_PATH="keys/AuthKey_XXXXXXXXXX.p8"
APNS_PRIVATE_KEY=""

# Google AI API Key
# Get this from https://aistudio.google.com/apikey
#
# Not required when DEMO_MODE is true: model calls return clearly-labelled
# canned output, no request leaves your machine, and no cost is incurred.
GOOGLE_API_KEY=""

# AI endpoint rate limiting (per user).
# The production default is 10 requests per minute. Integration test suites
# legitimately exceed that from a single seeded user, so set
# AI_RATE_LIMIT_ENABLED="false" on a test server to avoid a cascade of 429s.
# Leave these unset in production to keep the defaults.
AI_RATE_LIMIT_ENABLED="true"
# AI_RATE_LIMIT_REQUESTS="10"
# AI_RATE_LIMIT_WINDOW="60"

# Gemini model configurations for each agent
# All agents use Gemini 3 Flash — override per-agent if needed
GEMINI_MODEL_STRATEGY="gemini-3.8-flash"
GEMINI_MODEL_PERSONA="gemini-3.8-flash"
GEMINI_MODEL_CONTENT="gemini-3.8-flash"
GEMINI_MODEL_ANALYTICS="gemini-3.8-flash"
GEMINI_MODEL_OPPORTUNITIES="gemini-3.8-flash"
# Default model fallback if agent-specific model not set
GEMINI_MODEL_DEFAULT="gemini-3.8-flash"

# Enable Google Search grounding for agents (true/false)
GEMINI_ENABLE_GROUNDING="true"

# Gemini Thinking Budget
# -1 for dynamic thinking, 0 to disable (for supported models), or a specific token budget.
# See https://ai.google.dev/gemini-api/docs/thinking for details.
GEMINI_THINKING_LEVEL="medium"  # low | medium | high (minimal is invalid on 3.8 Flash)

# Unified Insight Extraction Configuration
# Model for insight extraction (separate from main chat for cost optimization)
GEMINI_MODEL_INSIGHT_EXTRACTION="gemini-3.8-flash"

# Enable/disable insight extraction globally
INSIGHT_EXTRACTION_ENABLED="false"

# Enable hybrid mode for agent-specific extraction schemas
INSIGHT_EXTRACTION_HYBRID_MODE="true"

# Comma-separated list of agents to enable extraction for
# Start with just strategy and marketing_strategy, then expand
# Options: strategy,marketing_strategy,persona,content,analytics,roi_budget,campaign_execution,quick_wins,competitive_intelligence,client_success
INSIGHT_EXTRACTION_AGENTS="strategy,marketing_strategy"

# Minimum confidence threshold for auto-approval (0.0 to 1.0)
INSIGHT_EXTRACTION_CONFIDENCE_THRESHOLD="0.70"

# Default monthly Gemini API spend limit per organization (USD)
INSIGHT_MONTHLY_LIMIT_DEFAULT="50.00"

# =====================================================================
# Application and branding
# =====================================================================
# URL of the web app. Used to build links in emails and invitations
# (apps/api/routers/team.py).
FRONTEND_URL="http://localhost:56310"

# Comma-separated browser origins allowed by CORS. Must be the web app's
# origin, not "*" — credentials are allowed, which requires specific origins.
ALLOWED_ORIGINS="http://localhost:56310,http://127.0.0.1:56310"
