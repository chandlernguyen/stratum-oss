# Backend test configuration — copy to tests/.env if the defaults do not fit.
#
# You usually do NOT need this file. tests/automated/test_config.py already
# falls back to the ports in supabase/config.toml (the 563xx range) and to the
# seeded test users, so `poetry run pytest` works on a fresh clone with no .env
# at all.
#
# Create tests/.env when you need to point the tests somewhere other than the
# local stack — a different port, a remote project, or a different test user.
# Values here override apps/api/.env, and real environment variables override
# both.

# --- Supabase (PostgREST) ---
# Get these from the `supabase start` output. The API URL is on port 56321.
SUPABASE_URL="http://127.0.0.1:56321"
SUPABASE_ANON_KEY=""
# Required by the integration tests that need to bypass RLS. Local development
# uses the deterministic service_role JWT printed by `supabase start`; test_config
# supplies it as a fallback, so this can generally stay blank locally.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Backend API (uvicorn) ---
# The README starts the API on port 56300, not FastAPI's default 8000.
API_BASE_URL="http://127.0.0.1:56300"

# --- Direct Postgres, for the tests that bypass PostgREST ---
DB_HOST="127.0.0.1"
DB_PORT="56322"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="postgres"

# --- Seeded test users (supabase/seed.sql) ---
TEST_EMAIL="sme.owner@example.com"
TEST_PASSWORD="LocalDevOnly123!"
AGENCY_OWNER_EMAIL="agency.owner@example.com"
